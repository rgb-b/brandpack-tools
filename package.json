{
  "name": "work-tools",
  "version": "3.0.0",
  "description": "Self-hosted team management tools",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev:bg": "sudo systemctl start work-tools-dev && journalctl -u work-tools-dev -f",
    "dev:stop": "sudo systemctl stop work-tools-dev",
    "start": "cd server && npm start",
    "build": "cd client && npm run build",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "migrate": "cd server && npm run migrate"
  },
  "keywords": [
    "work-tools",
    "proofing",
    "tools",
    "inventory",
    "maintenance"
  ],
  "author": "rgb-b",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
